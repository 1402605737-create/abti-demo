# Frontend build-time API base.
# Local development can keep it empty and rely on Vite proxy.
# Tencent Cloud CloudBase container deployment should also keep it empty
# when frontend and backend run in the same container and same domain.
VITE_API_BASE_URL=

# Backend runtime configuration
PORT=3000
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-real-key
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated allowed origins for the backend.
# When frontend and backend are served from the same container domain,
# this can be left empty.
CORS_ORIGIN=http://localhost:5173,https://your-frontend-domain.com

# Basic rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
